# Placeholders only. Real values go in Vercel > Project Settings > Environment
# Variables (Production), never in this repository.

# Exact origin allowed to call the API (no trailing slash).
ALLOWED_ORIGIN=https://rishinthel00p.github.io
# Hostname Turnstile must report for a valid token.
TURNSTILE_EXPECTED_HOSTNAME=rishinthel00p.github.io

# Secrets
TURNSTILE_SECRET_KEY=replace-me
RESEND_API_KEY=replace-me
UPSTASH_REDIS_REST_URL=https://replace-me.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me
# Long random string, e.g. output of: openssl rand -hex 32
RATE_LIMIT_SALT=replace-me

# Where messages are delivered (the Resend account's own address).
CONTACT_TO_EMAIL=owner@example.com
# Optional sender; Resend's shared test sender works without a domain.
CONTACT_FROM=Portfolio contact <onboarding@resend.dev>
