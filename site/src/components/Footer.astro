---
import { resume, siteRepoUrl } from '../lib/content.ts';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container foot">
    <p>© {year} {resume.basics.name}</p>
    <p class="meta">
      My work history, skills and credentials here are checked against my resume on every build.{" "}
      <a href="/security/">How this site is secured</a>{" · "}
      <a href={siteRepoUrl} rel="noopener noreferrer" target="_blank">View source</a>
    </p>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--border); padding: 28px 0 40px; color: var(--text-muted); font-size: 0.9rem; }
  .foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; }
  .foot p { margin: 0; }
</style>
