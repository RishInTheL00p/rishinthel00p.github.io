---
import { resume, copy, pillarData, statedYears } from '../lib/content.ts';
const { basics } = resume;
const pillarTitles = pillarData.pillars.map((p) => ({ id: p.id, title: copy(`pillar.${p.id}.title`) }));
const linkedin = basics.profiles.find((p) => p.network === 'LinkedIn');
const github = basics.profiles.find((p) => p.network === 'GitHub');
const stats = [
  { value: `${statedYears()}+`, label: 'years of expertise' },
  { value: String(resume.experience.length), label: 'employers' },
  { value: String(resume.certifications.length), label: 'certifications' },
  { value: String(resume.education.length), label: 'degrees' },
];
---
<section class="hero">
  <div class="container hero-grid">
    <div class="intro">
      <p class="eyebrow">{basics.location}</p>
      <h1>{basics.name}</h1>
      <p class="role">{basics.title}</p>
      <p class="tagline">{copy('hero.tagline')}</p>
      <div class="actions no-print">
        <a class="btn btn-primary" href="#pillars">Explore the loop</a>
        {linkedin && (
          <a class="btn" href={linkedin.url} rel="noopener noreferrer" target="_blank">LinkedIn</a>
        )}
        {github && (
          <a class="btn" href={github.url} rel="noopener noreferrer" target="_blank">GitHub</a>
        )}
      </div>
    </div>

    <figure class="terminal card" aria-label="Summary in a terminal window">
      <div class="term-bar" aria-hidden="true"><span></span><span></span><span></span><em>rish@loop: ~</em></div>
      <div class="term-body">
        <p class="cmd l1"><span class="ps" aria-hidden="true">$</span> whoami</p>
        <p class="out l2">{basics.name}</p>
        <p class="out l3">{basics.title}</p>
        <p class="cmd l4"><span class="ps" aria-hidden="true">$</span> ls ./pillars</p>
        <p class="out l5 pillars-out">
          {pillarTitles.map((p) => <span class={`p-${p.id}`}>{p.title}</span>)}
        </p>
        <p class="cmd l6"><span class="ps" aria-hidden="true">$</span> <span class="caret" aria-hidden="true"></span></p>
      </div>
    </figure>
  </div>

  <div class="container">
    <dl class="stats">
      {stats.map((s) => (
        <div>
          <dt>{s.label}</dt>
          <dd>{s.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .hero { padding: clamp(48px, 8vw, 96px) 0 clamp(40px, 6vw, 72px); position: relative; overflow: hidden; }
  .hero::before {
    content: ''; position: absolute; inset: -30% -10% auto auto; width: 70vw; height: 70vw; max-width: 900px; max-height: 900px;
    background:
      radial-gradient(closest-side, var(--ai-soft), transparent 70%) 0 0 / 60% 60% no-repeat,
      radial-gradient(closest-side, var(--appsec-soft), transparent 70%) 100% 30% / 60% 60% no-repeat,
      radial-gradient(closest-side, var(--vm-soft), transparent 70%) 40% 100% / 60% 60% no-repeat;
    pointer-events: none; z-index: -1;
  }
  .hero-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(28px, 5vw, 64px); align-items: center; }
  h1 { font-size: clamp(2.6rem, 7vw, 4.4rem); letter-spacing: -0.035em; margin-bottom: 0.2em; }
  .role { font-family: var(--font-mono); font-size: clamp(0.95rem, 1.8vw, 1.1rem); margin-bottom: 1.2em; }
  .tagline { font-size: clamp(1.1rem, 2.2vw, 1.3rem); color: var(--text-muted); max-width: 36ch; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }

  .terminal { margin: 0; overflow: hidden; font-family: var(--font-mono); font-size: 0.92rem; }
  .term-bar { display: flex; align-items: center; gap: 7px; padding: 11px 14px; border-bottom: 1px solid var(--border); background: var(--bg-sunken); }
  .term-bar span { width: 11px; height: 11px; border-radius: 50%; background: var(--border); }
  .term-bar em { margin-left: 8px; font-style: normal; font-size: 0.78rem; color: var(--text-muted); }
  .term-body { padding: 18px 20px 22px; }
  .term-body p { margin: 0 0 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ps { color: var(--human); margin-right: 6px; }
  .out { color: var(--text-muted); }
  .out.l2 { color: var(--text); font-weight: 600; }
  .pillars-out { display: flex; flex-wrap: wrap; gap: 4px 16px; white-space: normal; }
  .p-ai-security { color: var(--ai); }
  .p-application-security { color: var(--appsec); }
  .p-vulnerability-management { color: var(--vm); }
  .caret { display: inline-block; width: 0.6em; height: 1.1em; vertical-align: text-bottom; background: var(--text); animation: blink 1.1s steps(1) infinite; }

  /* Typing effect: each line is revealed left to right, in sequence. */
  .js .term-body p { clip-path: inset(0 100% 0 0); animation: type 0.7s steps(28, end) forwards; }
  .js .term-body .l1 { animation-delay: 0.2s; }
  .js .term-body .l2 { animation-delay: 1.0s; animation-duration: 0.3s; }
  .js .term-body .l3 { animation-delay: 1.4s; animation-duration: 0.4s; }
  .js .term-body .l4 { animation-delay: 2.0s; }
  .js .term-body .l5 { animation-delay: 2.8s; animation-duration: 0.4s; }
  .js .term-body .l6 { animation-delay: 3.3s; animation-duration: 0.1s; }
  @keyframes type { to { clip-path: inset(0 0 0 0); } }
  @keyframes blink { 50% { opacity: 0; } }

  .stats {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; margin: clamp(40px, 6vw, 64px) 0 0;
    background: var(--border); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden;
  }
  .stats div { background: var(--bg-elev); padding: 18px 20px; display: flex; flex-direction: column-reverse; }
  .stats dt { color: var(--text-muted); font-size: 0.9rem; }
  .stats dd { margin: 0; font-size: clamp(1.8rem, 4vw, 2.4rem); font-weight: 700; letter-spacing: -0.03em; font-family: var(--font-mono); }

  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; }
    .stats { grid-template-columns: repeat(2, 1fr); }
  }
  @media (prefers-reduced-motion: reduce) {
    .js .term-body p { clip-path: none; animation: none; }
  }
</style>
